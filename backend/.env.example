# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 절대 커밋하지 않는다.

# OpenAI API 키
OPENAI_API_KEY=

# Firebase 서비스 계정 키 JSON 전체를 한 줄 문자열로 (Render 배포용)
FIREBASE_SERVICE_ACCOUNT_JSON=
# 또는 로컬에서는 키 파일 경로를 지정해도 된다 (둘 중 하나)
FIREBASE_SERVICE_ACCOUNT_PATH=

# CORS 허용 도메인 목록 (쉼표 구분)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
